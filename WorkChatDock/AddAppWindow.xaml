<Window x:Class="WorkChatDock.AddAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加软件" Width="520" Height="285" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#11141B" Foreground="#F4F6FA">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1B202A" />
            <Setter Property="Foreground" Value="#F4F6FA" />
            <Setter Property="BorderBrush" Value="#343C4B" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#292F3B" />
            <Setter Property="Foreground" Value="#F4F6FA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="添加未收录的软件" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="名称" Foreground="#8F98AA" Margin="0,18,0,6" />
        <TextBox x:Name="NameBox" Grid.Row="2" />
        <Grid Grid.Row="3" Margin="0,15,0,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="程序文件" Foreground="#8F98AA" Margin="0,0,0,6" />
                <TextBox x:Name="PathBox" IsReadOnly="True" />
            </StackPanel>
            <Button Grid.Column="1" Content="浏览…" Margin="10,22,0,0" Click="BrowseButton_Click" />
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Click="CancelButton_Click" Margin="0,0,10,0" />
            <Button Content="添加" Background="#2F7BFF" Click="AddButton_Click" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="WorkChatDock.DockFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkChat Dock"
        Width="196" SizeToContent="Height" MaxHeight="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="DockButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A303D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="7" Padding="4" CornerRadius="14" Background="#F21A1E27"
            BorderBrush="#4D596C" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="5" Color="#000000" Opacity="0.40" />
        </Border.Effect>
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Bottom" Style="{StaticResource DockButton}" Click="LaunchAllButton_Click"
                    Margin="0,3,0,0">
                <TextBlock Text="▶  全部启动" Foreground="#BFC7D6" FontSize="11"
                           HorizontalAlignment="Center" />
            </Button>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DockApps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource DockButton}" Tag="{Binding}" Click="AppButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="26" Height="26">
                                        <Border CornerRadius="8" Background="#303644" />
                                        <Image Source="{Binding IconSource}" Width="22" Height="22" Stretch="Uniform" />
                                        <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Stroke="#1A1E27" StrokeThickness="1.5">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#697286" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Fill" Value="#32D69A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="#F4F6FA"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="6,0" />
                                    <Border Grid.Column="2" Background="#FF3155" CornerRadius="9" MinWidth="18" Height="18"
                                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="9" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>

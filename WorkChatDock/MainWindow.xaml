<Window x:Class="WorkChatDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WorkChat Dock"
        Width="820" Height="700" MinWidth="720" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="18" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2F7BFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#252A35" />
            <Setter Property="Foreground" Value="#E8EBF2" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </Window.Resources>

    <Border Margin="10" CornerRadius="18" Background="#11141B" BorderBrush="#343A48" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Color="#000000" Opacity="0.38" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="26,20,18,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="13" Background="#1D2330" Margin="0,0,13,0">
                        <Grid>
                            <Ellipse Width="9" Height="9" Fill="#1677FF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" />
                            <Ellipse Width="9" Height="9" Fill="#2F7BFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" />
                            <Ellipse Width="9" Height="9" Fill="#27C58B" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10" />
                            <Ellipse Width="9" Height="9" Fill="#F53053" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" />
                        </Grid>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="WorkChat Dock" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="主流办公与聊天软件，一个入口" Foreground="#8F98AA" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" Content="—" Click="MinimizeButton_Click" Margin="0,0,8,0" />
                    <Button Style="{StaticResource IconButton}" Content="×" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="26,12,26,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Click="LaunchAllButton_Click" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="全部启动" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="重新扫描" Click="RescanButton_Click" Margin="0,0,10,0" />
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="添加软件" Click="AddAppButton_Click" Margin="0,0,10,0" />
                <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="桌面快捷方式" Click="ShortcutButton_Click" />
                <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="消息检测" Foreground="#657087" FontSize="10" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding NotificationMode}" Foreground="#AAB2C2" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,0,14,0">
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6,0,12,12" Padding="16" CornerRadius="14" Background="#191D26"
                                    BorderBrush="#2B303C" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="52" Height="52" Margin="0,0,15,0">
                                        <Border CornerRadius="16" Background="#252A35" />
                                        <Image Source="{Binding IconSource}" Width="38" Height="38" Stretch="Uniform" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="20" Height="20"
                                                CornerRadius="10" Background="#FF3155" BorderBrush="#191D26" BorderThickness="2"
                                                Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}"
                                                Margin="0,-4,-4,0">
                                            <TextBlock Text="{Binding UnreadText}" Foreground="White" FontWeight="Bold" FontSize="10"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#F4F6FA" FontSize="16" FontWeight="SemiBold" />
                                            <Ellipse Width="7" Height="7" Margin="9,1,0,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#586174" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Fill" Value="#31D596" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}" Foreground="#8993A7" FontSize="12" Margin="7,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding PathText}" Foreground="#687286" FontSize="11" Margin="0,7,14,0"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding Enabled}" ToolTip="包含在全部启动中" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="移除" Tag="{Binding}" Click="RemoveButton_Click"
                                                Visibility="{Binding Definition.IsCustom, Converter={StaticResource BoolToVisibility}}"
                                                Margin="0,0,8,0" Padding="12,9" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="选择位置" Tag="{Binding}" Click="BrowseButton_Click" Margin="0,0,8,0" Padding="13,9" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="打开" Tag="{Binding}" Click="AppLaunchButton_Click" Padding="15,9" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3" Margin="26,8,26,22" Padding="13,10" CornerRadius="9" Background="#171B23">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="#2F7BFF" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#AAB2C2" FontSize="12" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="测试提醒"
                            Click="NotificationTestButton_Click" Padding="12,7" Margin="14,0,0,0"
                            ToolTip="让托盘聚合图标切换并闪烁 8 秒" />
                    <CheckBox Grid.Column="3" IsChecked="{Binding ManageTrayIcons}" Content="自动固定聚合图标并收纳原图标"
                              Foreground="#AAB2C2" FontSize="11" VerticalAlignment="Center" Margin="18,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
